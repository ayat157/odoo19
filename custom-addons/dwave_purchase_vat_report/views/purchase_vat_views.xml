<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- Wizard Form View -->
    <record id="view_purchase_vat_report_wizard_form" model="ir.ui.view">

        <field name="name">
            dwave.purchase.vat.report.wizard.form
        </field>

        <field name="model">
            dwave.purchase.vat.report.wizard
        </field>

        <field name="arch" type="xml">

            <form string="Purchase VAT Report">

                <sheet>

                    <group>

                        <group string="Report Period">

                            <field name="date_from"/>

                            <field name="date_to"/>

                        </group>


                        <group string="Filters">

                            <field name="company_id"/>

                            <field name="partner_ids"
                                   widget="many2many_tags"/>

                            <field name="tax_id"/>

                        </group>

                    </group>


                    <separator string="Export"/>


                    <group>

                        <field name="xlsx_file"
                               readonly="1"
                               filename="xlsx_filename"/>

                        <field name="xlsx_filename"
                               invisible="1"/>

                    </group>


                </sheet>


                <footer>

                    <button name="action_print_pdf"
                            type="object"
                            string="Print PDF"
                            class="btn-primary"/>


                    <button name="action_export_xlsx"
                            type="object"
                            string="Export Excel"
                            class="btn-secondary"/>


                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>


            </form>

        </field>

    </record>



    <!-- Wizard Action -->

    <record id="action_purchase_vat_report_wizard"
            model="ir.actions.act_window">

        <field name="name">
            Purchase VAT Report
        </field>

        <field name="res_model">
            dwave.purchase.vat.report.wizard
        </field>

        <field name="view_mode">
            form
        </field>

        <field name="target">
            new
        </field>

    </record>



    <!-- Menu -->

    <menuitem
        id="menu_purchase_vat_report"
        name="Purchase VAT Report"
        parent="account.menu_finance_reports"
        action="action_purchase_vat_report_wizard"
        sequence="50"
    />


</odoo>
