<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_invoice_report_search_inherit_agent" model="ir.ui.view">
        <field name="name">account.invoice.report.search.inherit.agent</field>
        <field name="model">account.invoice.report</field>
        <field name="inherit_id" ref="account.view_account_invoice_report_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='user']" position="after">
                <separator/>
                <filter string="Manager" name="manager" context="{'group_by': 'partner_id'}"/>
                <filter string="Supervisor" name="supervisor" context="{'group_by': 'partner_id'}"/>
                <filter string="Agent" name="agent" context="{'group_by': 'partner_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
