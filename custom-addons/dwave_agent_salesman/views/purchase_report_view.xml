<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_search_inherit_agent" model="ir.ui.view">
        <field name="name">purchase.report.search.inherit.agent</field>
        <field name="model">purchase.report</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='user_id']" position="after">
                <separator/>
                <filter string="Manager" name="manager" context="{'group_by': 'manager_id'}"/>
                <filter string="Supervisor" name="supervisor" context="{'group_by': 'supervisor_id'}"/>
                <filter string="Agent" name="agent" context="{'group_by': 'sales_man_id'}"/>
                <separator/>
                <filter string="Payment Terms" name="payment_term" context="{'group_by': 'payment_term_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>