<odoo>
    <record id="account_payment_form_inherit_sales_man" model="ir.ui.view">
        <field name="name">account.payment.form.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group2']//field[@name='payment_method_line_id']" position="after">
                <field name="sales_man_id" readonly="state != 'draft'" required="is_agent_required == True and payment_type != 'outbound'" invisible="payment_type == 'outbound'"/>
                <field name="supervisor_id" readonly="1" force_save="1"/>

            </xpath>
        </field>
    </record>


    <record id="account_payment_tree_view_inherit_sales_man" model="ir.ui.view">
        <field name="name">account.payment.tree.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list//field[@name='name']" position="after">
                <field name="sales_man_id"/>
                <field name="supervisor_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_search" model="ir.ui.view">
        <field name="name">account.payment.search</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search/field[@name='partner_id']" position="after">
                <field name="sales_man_id"/>
                <field name="supervisor_id"/>
            </xpath>
            <xpath expr="//search/filter[@name='partner']" position="after">
                <filter string="Sales Man" name="sales_man_id" domain="[]" context="{'group_by': 'sales_man_id'}"/>
                <filter string="Supervisor" name="supervisor_id" domain="[]" context="{'group_by': 'supervisor_id'}"/>
            </xpath>

        </field>
    </record>
    <record id="view_account_payment_register_form_inherit_agent" model="ir.ui.view">
        <field name="name">account.payment.register.form.inherit.agent</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <group position="inside">
                <group string="Agent Details">
                    <field name="sales_man_id" options="{'no_create': True}"/>
                    <field name="supervisor_id" readonly="1" force_save="1"/>
                </group>
            </group>
        </field>
    </record>

</odoo>
