<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_form_sale_view" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="inside">
                <setting id="sales_man_id" help="If enabled, Agent field becomes mandatory in related models.">
                    <field name="is_agent_required"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
