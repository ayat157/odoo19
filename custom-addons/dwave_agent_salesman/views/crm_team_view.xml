<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Inherit Form View to Modify it -->
        <record id="view_inherit_crem_team_form" model="ir.ui.view">
            <field name="name">view.inherit.crm.team.form</field>
            <field name="model">crm.team</field>
            <field name="inherit_id" ref="sales_team.crm_team_view_form"/>
            <field name="arch" type="xml">

                <xpath expr="//group[@name='right']" position="after">
                    <group>
                        
                        <field name="restrict_zero_cost"/>
                        <field name="restrict_unavailable_qty"/>
                    </group>
                </xpath>

            </field>
        </record>


    </data>
</odoo>
