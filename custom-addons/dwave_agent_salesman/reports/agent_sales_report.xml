<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sale_graph" model="ir.ui.view">
            <field name="name">sale.order.graph</field>
            <field name="model">sale.order</field>
            <field name="arch" type="xml">
                <graph string="Sale Commission">
                    <field name="agent_id"/>
                    <field name="partner_id"/>
                    <field name="amount_total" type="measure"/>
<!--                    <field name="city"/>-->
<!--                    <field name="area_id" type="measure"/>-->
                </graph>
            </field>
        </record>

        <record id="sale_pivot" model="ir.ui.view">
            <field name="name">sale.order.pivot</field>
            <field name="model">sale.order</field>
            <field name="arch" type="xml">
                <pivot string="Sales Orders" sample="1">
                    <field name="date_order" type="row"/>
                    <field name="amount_total" type="measure"/>
                    <field name="agent_id" type="measure"/>
                    <field name="partner_id" type="measure"/>
<!--                    <field name="city" type="measure"/>-->
<!--                    <field name="area_id" type="measure"/>-->
                </pivot>
            </field>
        </record>

        <record model="ir.actions.act_window" id="sale_action">
            <field name="name">Sale Orders</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">pivot,graph</field>
            <field name="search_view_id" ref="sale.sale_order_view_search_inherit_sale"/>

        </record>

        <record model="ir.actions.act_window.view" id="sale_pivot_all">
            <field name="sequence" eval="2"/>
            <field name="view_mode">pivot</field>
            <field name="view_id" ref="sale_pivot"/>
            <field name="act_window_id" ref="sale_action"/>
        </record>
        <record model="ir.actions.act_window.view" id="sale_graph_all">
            <field name="sequence" eval="3"/>
            <field name="view_mode">graph</field>
            <field name="view_id" ref="sale_graph"/>
            <field name="act_window_id" ref="sale_action"/>
        </record>

        <menuitem id="menu_sale_report" parent="sale.menu_sale_report" action="sale_action"
                  sequence="5"/>

    </data>
</odoo>
