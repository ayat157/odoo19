<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================
         USER FORM EXTENSION
    ========================== -->
    <record id="view_users_form_warehouse_restriction" model="ir.ui.view">
        <field name="name">res.users.form.warehouse.restriction</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">

            <!-- Warehouse Restrictions -->
            <xpath expr="//form//sheet" position="inside">
                <group string="Warehouse Restrictions">
                    <field name="default_picking_type_ids"
                           widget="many2many_tags"/>
                </group>
            </xpath>

        </field>
    </record>

    <!-- =========================
         LOCATION RESTRICTIONS
    ========================== -->
    <record id="view_location_security_users_form" model="ir.ui.view">
        <field name="name">res.users.form.location.restriction</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">

            <!-- Add new page safely -->
            <xpath expr="//notebook" position="inside">
                <page string="Allowed Stock Locations">

                    <group>
                        <field name="restrict_locations"/>

                        <field name="stock_location_ids"
                               widget="many2many_tags"
                               invisible="not restrict_locations"/>
                    </group>

                </page>
            </xpath>

        </field>
    </record>

</odoo>
