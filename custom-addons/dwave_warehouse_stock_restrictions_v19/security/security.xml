<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Security Group: Restrict Stock Warehouses -->
        <record id="group_restrict_warehouse" model="res.groups">
            <field name="name">Restrict Stock Warehouses</field>
        </record>

        <!-- Record Rule: Filter Picking Types by Allowed Operations -->
        <record id="filter_user_stock_picking_type_allowed" model="ir.rule">
            <field name="name">Filter Stock Picking Type - Allowed Only</field>
            <field name="model_id" search="[('model', '=', 'stock.picking.type')]" model="ir.model"/>
            <field name="groups" eval="[(4, ref('group_restrict_warehouse'))]"/>
            <field name="domain_force">
             [
            '|',
            '|',
           ('location_id', 'in', user.stock_location_ids.ids),
           ('location_dest_id', 'in', user.stock_location_ids.ids),
           ('picking_type_id.code', '=', 'internal')
             ]
           </field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Record Rule: Filter Stock Moves by Allowed Locations -->
        <record id="stock_move_rule" model="ir.rule">
            <field name="name">Allowed Stock Locations</field>
            <field name="model_id" search="[('model', '=', 'stock.move')]" model="ir.model"/>
            <field name="groups" eval="[(4, ref('group_restrict_warehouse'))]"/>
            <field name="domain_force">
                [('location_id', 'in', user.stock_location_ids.ids)]
            </field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
